diff --git a/ps2xRuntime/src/lib/Kernel/OtavixArena.cpp b/ps2xRuntime/src/lib/Kernel/OtavixArena.cpp
new file mode 100644
index 0000000..d490928
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/OtavixArena.cpp
@@ -0,0 +1,81 @@
+#include "OtavixArena.h"
+#include "ps2_runtime.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+
+namespace otx
+{
+    namespace
+    {
+        constexpr uint32_t kArenaBase = 0x00040000u;
+        constexpr uint32_t kArenaFim = 0x00070000u; // remendos de kernel da SDK usam 0x75000
+
+        std::mutex g_arenaMutex;
+        std::map<uint32_t, uint32_t> g_arenaUsados; // início -> tamanho
+
+        bool arenaLigada()
+        {
+            static const bool ligada = []
+            {
+                const char *e = std::getenv("PS2X_ARENA");
+                return !(e && e[0] == '0');
+            }();
+            return ligada;
+        }
+
+        uint32_t alinha(uint32_t valor, uint32_t alinhamento)
+        {
+            return (valor + alinhamento - 1u) & ~(alinhamento - 1u);
+        }
+    }
+
+    uint32_t alocaInterno(PS2Runtime *runtime, uint32_t tamanho, uint32_t alinhamento)
+    {
+        if (arenaLigada())
+        {
+            if (tamanho == 0u)
+            {
+                tamanho = 1u;
+            }
+            if (alinhamento < 16u || (alinhamento & (alinhamento - 1u)) != 0u)
+            {
+                alinhamento = 16u;
+            }
+            std::lock_guard<std::mutex> lock(g_arenaMutex);
+            uint32_t candidato = kArenaBase;
+            for (const auto &[inicio, usado] : g_arenaUsados)
+            {
+                candidato = alinha(candidato, alinhamento);
+                if (candidato + tamanho <= inicio)
+                {
+                    break;
+                }
+                candidato = std::max(candidato, inicio + usado);
+            }
+            candidato = alinha(candidato, alinhamento);
+            if (candidato + tamanho <= kArenaFim)
+            {
+                g_arenaUsados[candidato] = tamanho;
+                return candidato;
+            }
+        }
+        return runtime ? runtime->guestMalloc(tamanho, alinhamento) : 0u;
+    }
+
+    void liberaInterno(PS2Runtime *runtime, uint32_t endereco)
+    {
+        if (endereco >= kArenaBase && endereco < kArenaFim)
+        {
+            std::lock_guard<std::mutex> lock(g_arenaMutex);
+            g_arenaUsados.erase(endereco);
+            return;
+        }
+        if (runtime && endereco != 0u)
+        {
+            runtime->guestFree(endereco);
+        }
+    }
+}
diff --git a/ps2xRuntime/src/lib/Kernel/OtavixArena.h b/ps2xRuntime/src/lib/Kernel/OtavixArena.h
new file mode 100644
index 0000000..5a6868c
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/OtavixArena.h
@@ -0,0 +1,15 @@
+#pragma once
+// Otavix: arena para os pacotes e buffers internos do runtime (GS, fonte, SIF, MPEG).
+// O guestMalloc começa logo depois do ELF, que é onde o jogo monta o próprio heap quando não usa o
+// malloc da libc: o Ghost Rider perdia uma lista porque o sceGsResetGraph montava o pacote GIF em
+// cima dela. A arena fica em 0x40000-0x70000, memória do kernel no PS2 que os jogos não usam; cheia,
+// cai no guestMalloc. PS2X_ARENA=0 desliga (tudo no guestMalloc, como antes).
+#include <cstdint>
+
+class PS2Runtime;
+
+namespace otx
+{
+    uint32_t alocaInterno(PS2Runtime *runtime, uint32_t tamanho, uint32_t alinhamento = 16u);
+    void liberaInterno(PS2Runtime *runtime, uint32_t endereco);
+}
