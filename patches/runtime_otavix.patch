+// Otavix: teste diferencial das rotinas de double por software do jogo (PS2X_TESTA_DOUBLE=
+// nome:endereço,... com nome em dpmul/dpadd/dpsub/dpdiv/pow/ipow/sqrt/litodp/dptoli/fptodp e
+// PS2X_TESTA_GP=<gp do jogo>): chama o código traduzido com entradas conhecidas (doubles em GPR de 64
+// bits, resultado em v0) por um mini-despachante e compara com a conta nativa.
+static bool otxChamaGuest(PS2Runtime *rt, uint8_t *rdram, uint32_t addr, uint32_t gp, uint64_t a0, uint64_t a1,
+                          float f12, uint64_t &v0)
+{
+    constexpr uint32_t kSentinela = 0x00000FF0u;
+    R5900Context c{};
+    std::memset(static_cast<void *>(&c), 0, sizeof(c));
+    c.cop0_status = 0x00010001u;
+    SET_GPR_U32(&c, 28, gp);
+    SET_GPR_U32(&c, 29, 0x01E80000u);
+    SET_GPR_U32(&c, 31, kSentinela);
+    c.r[4] = _mm_set_epi64x(0, static_cast<int64_t>(a0));
+    c.r[5] = _mm_set_epi64x(0, static_cast<int64_t>(a1));
+    c.f[12] = f12;
+    c.pc = addr;
+    for (int passos = 0; passos < 2000000; ++passos)
+    {
+        if (c.pc == kSentinela)
+        {
+            v0 = static_cast<uint64_t>(_mm_extract_epi64(c.r[2], 0));
+            return true;
+        }
+        if (c.pc == 0u || !rt->hasFunction(c.pc))
+        {
+            std::cout << "[testa] parou em pc=0x" << std::hex << c.pc << std::dec << std::endl;
+            return false;
+        }
+        rt->lookupFunction(c.pc)(rdram, &c, rt);
+    }
+    std::cout << "[testa] passos demais" << std::endl;
+    return false;
+}
+
+static void otxTestaDouble(PS2Runtime *rt, uint8_t *rdram)
+{
+    const char *s = std::getenv("PS2X_TESTA_DOUBLE");
+    if (!s || !*s)
+        return;
+    const char *g = std::getenv("PS2X_TESTA_GP");
+    const uint32_t gp = g ? static_cast<uint32_t>(std::strtoul(g, nullptr, 16)) : 0u;
+    auto bits = [](double d) { uint64_t u; std::memcpy(&u, &d, 8); return u; };
+    auto dbl = [](uint64_t u) { double d; std::memcpy(&d, &u, 8); return d; };
+    const double pares[][2] = {{1.5, 2.0}, {0.5, 0.8163265}, {2.0, 0.5}, {3.7, 1.25}, {100.0, 0.1}, {0.12345, 7.0}, {200.0, 3.0}};
+    std::string lista(s);
+    size_t pos = 0;
+    while (pos < lista.size())
+    {
+        size_t fim = lista.find(',', pos);
+        if (fim == std::string::npos) fim = lista.size();
+        const std::string item = lista.substr(pos, fim - pos);
+        pos = fim + 1;
+        const size_t dp = item.find(':');
+        if (dp == std::string::npos) continue;
+        const std::string nome = item.substr(0, dp);
+        const uint32_t addr = static_cast<uint32_t>(std::strtoul(item.c_str() + dp + 1, nullptr, 16));
+        for (const auto &pr : pares)
+        {
+            const double x = pr[0], y = pr[1];
+            double esperado = 0.0;
+            uint64_t a0 = bits(x), a1 = bits(y);
+            float f12 = 0.0f;
+            bool resultadoInteiro = false;
+            if (nome == "dpmul") esperado = x * y;
+            else if (nome == "dpadd") esperado = x + y;
+            else if (nome == "dpsub") esperado = x - y;
+            else if (nome == "dpdiv") esperado = x / y;
+            else if (nome == "pow" || nome == "ipow") esperado = std::pow(x, y);
+            else if (nome == "sqrt") esperado = std::sqrt(x);
+            else if (nome == "litodp") { a0 = static_cast<uint64_t>(static_cast<int64_t>(x * 7)); esperado = static_cast<double>(static_cast<int64_t>(x * 7)); }
+            else if (nome == "dptoli") { esperado = static_cast<double>(static_cast<int32_t>(x * 3.3)); a0 = bits(x * 3.3); resultadoInteiro = true; }
+            else if (nome == "fptodp") { f12 = static_cast<float>(x); esperado = static_cast<double>(f12); }
+            else continue;
+            uint64_t v0 = 0;
+            const bool ok = otxChamaGuest(rt, rdram, addr, gp, a0, a1, f12, v0);
+            const double obtido = resultadoInteiro ? static_cast<double>(static_cast<int32_t>(v0)) : dbl(v0);
+            const bool certo = ok && std::fabs(obtido - esperado) <= 1e-9 * std::max(1.0, std::fabs(esperado));
+            std::printf("[testa] %s(%g, %g) = %.12g esperado %.12g %s\n", nome.c_str(), x, y, obtido, esperado, certo ? "OK" : "ERRADO");
+        }
+    }
+    std::fflush(stdout);
+}
