+// Otavix: número do desenho do GS (para cruzar com as trocas de buffer em outros registros)
+std::atomic<uint32_t> g_otxPrimSeq{0u};
+// Otavix: janela de registro por número de desenho: PS2X_LOG_SEQ=<de>,<n>, ou por tempo:
+// PS2X_LOG_SEQ_SEG=<segundos>,<n> (abre no primeiro desenho depois de <segundos>)
+static std::atomic<uint32_t> g_otxJanDe{0u}, g_otxJanAte{0u};
+static uint32_t g_otxJanSeg = 0u, g_otxJanN = 0u;
+static void otxJanelaIniciar()
+{
+    static const bool lido = []() {
+        if (const char *s = std::getenv("PS2X_LOG_SEQ"))
+        {
+            const uint32_t de = static_cast<uint32_t>(std::atoi(s));
+            const char *v = std::strchr(s, ',');
+            g_otxJanDe = de;
+            g_otxJanAte = de + (v ? static_cast<uint32_t>(std::atoi(v + 1)) : 300u);
+        }
+        else if (const char *s2 = std::getenv("PS2X_LOG_SEQ_SEG"))
+        {
+            g_otxJanSeg = static_cast<uint32_t>(std::atoi(s2));
+            const char *v = std::strchr(s2, ',');
+            g_otxJanN = v ? static_cast<uint32_t>(std::atoi(v + 1)) : 300u;
+        }
+        return true;
+    }();
+    (void)lido;
+}
+// chamado a cada desenho: abre a janela por tempo quando chegar a hora
+static void otxJanelaPorTempo(uint32_t seqI)
+{
+    if (g_otxJanSeg == 0u || g_otxJanAte.load(std::memory_order_relaxed) != 0u)
+        return;
+    static const auto t0 = std::chrono::steady_clock::now();
+    if (std::chrono::steady_clock::now() - t0 >= std::chrono::seconds(g_otxJanSeg))
+    {
+        g_otxJanDe = seqI;
+        g_otxJanAte = seqI + g_otxJanN;
+        std::cout << "[janela] aberta no desenho " << seqI << " (" << g_otxJanSeg << " s)" << std::endl;
+    }
+}
+bool otxJanelaLog()
+{
+    otxJanelaIniciar();
+    const uint32_t i = g_otxPrimSeq.load(std::memory_order_relaxed);
+    const uint32_t ate = g_otxJanAte.load(std::memory_order_relaxed);
+    return ate != 0u && i >= g_otxJanDe.load(std::memory_order_relaxed) && i < ate;
+}
+
+extern std::atomic<uint64_t> g_otxNsGs;
+namespace
+{
+    // Otavix: soma o tempo de cada desenho em g_otxNsGs (contador de desempenho do [fps])
+    struct OtxCronometroGs
+    {
+        std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+        ~OtxCronometroGs()
+        {
+            g_otxNsGs.fetch_add(static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()));
+        }
+    };
+}
