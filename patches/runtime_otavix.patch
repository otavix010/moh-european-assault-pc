+++ b/ps2xRuntime/src/lib/Kernel/OtavixVigia.cpp
@@ -0,0 +1,89 @@
+// Otavix: vigia de escrita na RAM do EE (diagnóstico), num arquivo próprio porque precisa do
+// windows.h, que conflita com o raylib incluído pelo ps2_runtime.cpp.
+// PS2X_VIGIA=<endereço hex>,<bytes>: a página da RAM vira só leitura; cada escrita na faixa é
+// registrada com o PC/RA do EE ([vigia] ...) e a instrução segue (passo único e reproteção).
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+namespace otx
+{
+    using PegaPc = void (*)(uint32_t &pc, uint32_t &ra);
+
+    namespace
+    {
+        uint8_t *g_rdram = nullptr;
+        PegaPc g_pegaPc = nullptr;
+        uint32_t g_ini = 0u, g_len = 0u;
+        uintptr_t g_pagIni = 0u, g_pagFim = 0u;
+        std::atomic<int> g_hits{0};
+        thread_local bool t_reproteger = false;
+
+#ifdef _WIN32
+        LONG CALLBACK veh(PEXCEPTION_POINTERS ep)
+        {
+            EXCEPTION_RECORD *er = ep->ExceptionRecord;
+            if (er->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && er->NumberParameters >= 2 &&
+                er->ExceptionInformation[0] == 1)
+            {
+                const uintptr_t a = er->ExceptionInformation[1];
+                if (a >= g_pagIni && a < g_pagFim)
+                {
+                    const uint32_t guest = static_cast<uint32_t>(a - reinterpret_cast<uintptr_t>(g_rdram));
+                    if (guest >= g_ini && guest < g_ini + g_len && g_hits.fetch_add(1) < 400)
+                    {
+                        uint32_t pc = 0u, ra = 0u;
+                        if (g_pegaPc)
+                            g_pegaPc(pc, ra);
+                        std::printf("[vigia] escrita em 0x%08X pc=0x%08X ra=0x%08X thread=%lu\n", guest, pc, ra,
+                                    static_cast<unsigned long>(GetCurrentThreadId()));
+                        std::fflush(stdout);
+                    }
+                    DWORD velho = 0;
+                    VirtualProtect(reinterpret_cast<void *>(g_pagIni), g_pagFim - g_pagIni, PAGE_READWRITE, &velho);
+                    ep->ContextRecord->EFlags |= 0x100u;
+                    t_reproteger = true;
+                    return EXCEPTION_CONTINUE_EXECUTION;
+                }
+            }
+            if (er->ExceptionCode == EXCEPTION_SINGLE_STEP && t_reproteger)
+            {
+                t_reproteger = false;
+                DWORD velho = 0;
+                VirtualProtect(reinterpret_cast<void *>(g_pagIni), g_pagFim - g_pagIni, PAGE_READONLY, &velho);
+                return EXCEPTION_CONTINUE_EXECUTION;
+            }
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+#endif
+    }
+
+    void vigiaIniciar(uint8_t *rdram, PegaPc pegaPc)
+    {
+        const char *s = std::getenv("PS2X_VIGIA");
+        if (!s || !*s || !rdram)
+            return;
+        g_rdram = rdram;
+        g_pegaPc = pegaPc;
+        g_ini = static_cast<uint32_t>(std::strtoul(s, nullptr, 16)) & 0x1FFFFFFu;
+        const char *v = std::strchr(s, ',');
+        g_len = v ? static_cast<uint32_t>(std::strtoul(v + 1, nullptr, 0)) : 4u;
+#ifdef _WIN32
+        const uintptr_t base = reinterpret_cast<uintptr_t>(rdram);
+        g_pagIni = (base + g_ini) & ~static_cast<uintptr_t>(0xFFFu);
+        g_pagFim = (base + g_ini + g_len + 0xFFFu) & ~static_cast<uintptr_t>(0xFFFu);
+        AddVectoredExceptionHandler(1, veh);
+        DWORD velho = 0;
+        VirtualProtect(reinterpret_cast<void *>(g_pagIni), g_pagFim - g_pagIni, PAGE_READONLY, &velho);
+        std::printf("[vigia] vigiando 0x%08X +%u\n", g_ini, g_len);
+        std::fflush(stdout);
+#endif
+    }
+}
